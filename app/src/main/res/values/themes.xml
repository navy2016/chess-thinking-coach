<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Coach" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorPrimaryContainer">@color/brandLight</item>
        <item name="android:statusBarColor">@color/brandDark</item>
        <item name="android:windowBackground">@color/paper</item>
    </style>
    <style name="Theme.Coach.Match" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/coach_accent</item>
        <item name="colorOnPrimary">@color/coach_on_accent</item>
        <item name="android:windowBackground">@color/coach_surface</item>
        <item name="android:statusBarColor">@color/coach_surface</item>
        <item name="android:navigationBarColor">@color/coach_surface</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
